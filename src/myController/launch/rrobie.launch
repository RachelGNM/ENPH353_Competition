<launch>
    <!-- Launch driver node -->
    <node pkg="myController" type="driver.py" name="driver" output="screen"/>

    <!-- Launch left clue reader node -->
    <node pkg="myController" type="left_reader.py" name="left_reader" output="screen"/>

    <!-- Launch right clue reader node -->
    <node pkg="myController" type="right_reader.py" name="right_reader" output="screen"/>
</launch>
